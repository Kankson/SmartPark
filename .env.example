# Safe local defaults. `pnpm dev` copies this file to .env.local if needed.
# Use your public HTTPS Vercel URL in production so QR and webhook links work on phones.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Local database. Defaults to .data/smartpark.db; use :memory: for a throwaway run.
# SMARTPARK_DB_PATH=.data/smartpark.db

# Payment provider: mock moves no real money; switch to aza only after adding both secrets below.
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_WEBHOOK_SECRET=replace-with-random-dev-secret

# AZA merchant API (server-only; never rename these with a NEXT_PUBLIC_ prefix)
AZA_API_BASE_URL=https://api.aza.systems
AZA_API_KEY=aza_test_replace-with-api-key
AZA_WEBHOOK_SECRET=replace-with-webhook-signing-secret

# QR ticket hashing
QR_TOKEN_PEPPER=replace-with-random-server-only-pepper

# Optional external integrations
PLATE_RECOGNITION_PROVIDER=
