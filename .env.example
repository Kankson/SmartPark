# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Local database. Defaults to .data/smartpark.db; use :memory: for a throwaway run.
# SMARTPARK_DB_PATH=.data/smartpark.db

# Payment provider: use mock locally or aza for AZA hosted checkout
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_WEBHOOK_SECRET=replace-with-random-dev-secret

# AZA merchant API (server-only)
AZA_API_BASE_URL=https://api.aza.systems
AZA_API_KEY=aza_test_replace-with-api-key
AZA_WEBHOOK_SECRET=replace-with-webhook-signing-secret

# QR ticket hashing
QR_TOKEN_PEPPER=replace-with-random-server-only-pepper

# Optional external integrations
PLATE_RECOGNITION_PROVIDER=
